{
  "expo": {
    "name": "crusteezpizza",
    "slug": "pizza-order-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crusteezpizza",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahwajsolutions.crusteezpizza"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "SEND_SMS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mahwajsolutions.crusteezpizza",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "env": {
        "KITCHEN_APP_API_KEY": "sk_KKPfNSBEHhqCEarfKaGNtVBI6CIDjaRO",
        "SUBABASE_URL_BASE": "https://bufiduycxibmrbtfsdkk.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_v_9FGlFcqOsan8AxexQEcA_mq_PK1vo"
      },
